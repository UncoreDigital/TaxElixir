# ---------------------------------------------------------------------------
# TaxElixir — environment
# Copy to .env.local and fill in. .env.local is gitignored.
# ---------------------------------------------------------------------------

# Public site URL, used for canonical tags, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.taxelixir.com

# Supabase — Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SERVER ONLY — never prefix with NEXT_PUBLIC_ and never
# reference it from a client component. Used for signed download URLs in admin.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — transactional email for lead notifications. https://resend.com
RESEND_API_KEY=
# Must be a verified sending domain in Resend.
LEAD_NOTIFICATION_FROM=TaxElixir Website <no-reply@taxelixir.com>
# Where new enquiry notifications are delivered.
LEAD_NOTIFICATION_TO=info@taxelixir.com
